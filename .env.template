# KamaKal Environment Variables Template
# NOTE: iOS applications do not read from `.env` files natively out of the box.
# In this project, you must copy these values into `KamaKal/Services/Constants.swift` before building.
# This file serves as a reference for the required environment keys.

# ==========================================
# SUPABASE CONFIGURATION
# Found at: Supabase Dashboard -> Project Settings -> API
# ==========================================
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ==========================================
# GOOGLE GEMINI CONFIGURATION
# Found at: https://aistudio.google.com/apikey
# ==========================================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
